{
  "description": "Local quality freshness notices. Requires normal Codex hook review/trust; never blocks or restarts the agent.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node --input-type=module -e \"import {execFileSync} from 'node:child_process';import {pathToFileURL} from 'node:url';import {join} from 'node:path';await import(pathToFileURL(join(execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(),'scripts/qa-hook.mjs')).href)\"", "timeout": 3 }] }],
    "PostToolUse": [{ "matcher": "apply_patch|exec_command|functions.exec", "hooks": [{ "type": "command", "command": "node --input-type=module -e \"import {execFileSync} from 'node:child_process';import {pathToFileURL} from 'node:url';import {join} from 'node:path';await import(pathToFileURL(join(execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(),'scripts/qa-hook.mjs')).href)\"", "timeout": 3 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node --input-type=module -e \"import {execFileSync} from 'node:child_process';import {pathToFileURL} from 'node:url';import {join} from 'node:path';await import(pathToFileURL(join(execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(),'scripts/qa-hook.mjs')).href)\"", "timeout": 3 }] }]
  }
}
