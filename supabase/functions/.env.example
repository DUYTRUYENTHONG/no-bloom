# Copy to supabase/functions/.env for local development; never commit the real file.
# Copy the project's transaction-pooler URI from Supabase Dashboard → Connect.
ANALYTICS_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
ANALYTICS_ALLOWED_ORIGINS=https://duytruyenthong.github.io,http://localhost:3100
ANALYTICS_MINUTE_CAP=60
ANALYTICS_DAY_CAP=10000
COUNTER_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_STABLE_ACROSS_DEPLOYS
COUNTER_MINUTE_CAP=60
COUNTER_DAY_CAP=10000
GROQ_API_KEY=SET_IN_SUPABASE_FUNCTION_SECRETS_ONLY
GROQ_MODEL=llama-3.3-70b-versatile
GUIDE_DAILY_CAP=200
# Local Supabase database only, if its connection does not provide TLS:
# ANALYTICS_DB_SSL=disable
