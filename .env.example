# Public build-time values only. The collector stays disabled until configured.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/record-visit
NEXT_PUBLIC_COUNTER_ENABLED=false
NEXT_PUBLIC_COUNTER_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/visitor-counter
NEXT_PUBLIC_GUIDE_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/flower-guide

# Local exported-build tests only. Never set in the Pages workflow.
# NEXT_PUBLIC_ANALYTICS_TEST_MODE=true
# NEXT_PUBLIC_COUNTER_TEST_MODE=true
