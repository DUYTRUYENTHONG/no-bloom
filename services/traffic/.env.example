# Server only. Add through Vercel environment settings, never frontend build variables.
KV_REST_API_URL=https://YOUR_DATABASE.upstash.io
KV_REST_API_TOKEN=YOUR_SERVER_ONLY_REST_TOKEN
TRAFFIC_HASH_SALT=GENERATE_A_PROJECT_SPECIFIC_SECRET_AT_LEAST_32_CHARACTERS
TRAFFIC_ALLOWED_ORIGINS=https://duytruyenthong.github.io,http://localhost:3100
TRAFFIC_NAMESPACE=no-bloom:traffic:v1
TRAFFIC_MINUTE_CAP=120
TRAFFIC_DAY_CAP=10000
TRAFFIC_BROWSER_CAP=100000
